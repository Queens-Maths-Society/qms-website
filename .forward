#Exim Filter
# Exim .forward file for qms generated by srcf-autoforward

if ( $local_part_suffix is "-president" ) then
    deliver hj390@cam.ac.uk
endif

if ( $local_part_suffix is "-vice-president" ) then
    deliver ak2623@cam.ac.uk
endif

if ( $local_part_suffix is "-secretary" ) then
    deliver bb703@cam.ac.uk
endif

if ( $local_part_suffix is "-treasurer" ) then
    deliver kis29@cam.ac.uk
endif

if ( $local_part_suffix is "-social-secretary" ) then
    deliver svo23@cam.ac.uk
endif

if ( $local_part_suffix is "-academic-officer" ) then
    deliver lh881@cam.ac.uk
endif

if not delivered then
    deliver hj390@cam.ac.uk
    deliver bb703@cam.ac.uk
endif

